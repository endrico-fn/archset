#!/bin/bash

build() {
    if [[ ! -x /usr/local/lib/systemd/archrelius-askpw ]]; then
        warning "archrelius-askpw binary missing; keeping stock systemd-tty-ask-password-agent"
        return 0
    fi

    add_binary /usr/local/lib/systemd/archrelius-askpw

    if [[ -f /etc/archrelius.conf && ! -L /etc/archrelius.conf ]]; then
        add_file /etc/archrelius.conf
    fi

    printf '%s\n' \
        '[Service]' \
        'ExecStart=' \
        'ExecStart=/usr/local/lib/systemd/archrelius-askpw --watch --console' \
        'LimitCORE=0' \
        'IPAddressDeny=any' \
        'RestrictAddressFamilies=AF_UNIX' \
        'MemoryDenyWriteExecute=yes' \
        'LockPersonality=yes' \
        'RestrictRealtime=yes' \
        | add_systemd_drop_in systemd-ask-password-console.service 10-archrelius
}

help() {
    cat <<HELPEOF
This hook installs the hardened, customizable ARCHRELIUS TUI password agent
(/etc/archrelius.conf) for sd-encrypt inside the initramfs, with automatic
fallback to systemd-tty-ask-password-agent.
HELPEOF
}

