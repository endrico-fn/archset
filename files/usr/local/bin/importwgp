#!/usr/bin/env bash
# importwgp - Hardened Proton WireGuard profile manager for Arch Linux.
# Manages a single active wg-quick interface (png0) backed by a root-owned
# library of sanitized profiles (/etc/wireguard/profiles/) and hot-reloads
# via systemd (wg syncconf) using Polkit-backed run0 (non-SetUID).
set -euo pipefail
umask 077
export LC_ALL=C
export PATH="/usr/bin:/usr/sbin"

readonly PROG="importwgp"
readonly IFACE="png0"
readonly UNIT="wg-quick@${IFACE}.service"
readonly WG_DIR="/etc/wireguard"
readonly PROFILES_DIR="${WG_DIR}/profiles"
readonly ACTIVE_CONF="${WG_DIR}/${IFACE}.conf"
readonly STATE_DIR="/var/lib/importwgp"
readonly INDEX_FILE="${STATE_DIR}/index.tsv"
readonly DEFAULT_SOURCE_DIR="${HOME}/Downloads"
readonly PROFILE_NAME_RE='^[a-z0-9][a-z0-9._-]{0,63}$'
readonly MAX_CONFIG_BYTES=65536

# ---------- Output helpers ----------
if [[ -t 1 ]]; then
    C_CYAN=$'\033[1;36m'
    C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'
    C_RED=$'\033[1;31m'
    C_DIM=$'\033[2m'
    C_BOLD=$'\033[1m'
    C_NC=$'\033[0m'
else
    C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_DIM='' C_BOLD='' C_NC=''
fi

ok()   { printf '  %s✓%s  %s\n' "$C_GREEN" "$C_NC" "$*"; }
warn() { printf '  %s!%s  %s\n' "$C_YELLOW" "$C_NC" "$*"; }
err()  { printf '  %s✗%s  %s\n' "$C_RED" "$C_NC" "$*" >&2; }

ORIG_STTY=""
CANONICAL_CONFIG=""

cleanup() {
    CANONICAL_CONFIG=""
    unset CANONICAL_CONFIG 2>/dev/null || true
    if [[ -n $ORIG_STTY && -t 0 ]]; then
        /usr/bin/stty "$ORIG_STTY" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# ---------- State ----------
ACTION=""
SOURCE_DIR="$DEFAULT_SOURCE_DIR"
SRC_FILE=""
PROFILE_NAME=""
ACTIVATE=1
KEEP_DNS=0
DELETE_SOURCE=""   # "", "yes", "no"
ASSUME_YES=0
DRY_RUN=0

# Parsed metadata populated by parse_and_sanitize()
P_LABEL=""
P_ADDRESS=""
P_ENDPOINT=""
P_ALLOWED_IPS=""
P_MTU=""
P_DNS=""
P_HAS_FULL_V4=0
P_STRIPPED_DNS=""
P_STRIPPED_IPV6=""
P_PEER_COUNT=0

# ---------- Usage ----------
usage() {
    cat <<EOF
Usage: ${PROG} [options]

Without options, an interactive TUI menu is shown.
Manages ${IFACE} (${UNIT}) using a sanitized profile library in ${PROFILES_DIR}.

Actions (one-shot mode):
  --status              Show current ${IFACE} & DNS status (non-root)
  --list                List saved profiles and detected configs in --dir
  --import              Import a Proton .conf into ${PROFILES_DIR} (default if --file given)
  --switch NAME         Switch ${IFACE} to saved profile NAME (hot-reload if possible)
  --delete NAME         Remove saved profile NAME (refuses active profile)
  --adopt               Adopt & sanitize current ${ACTIVE_CONF} into library
  --start               Start ${UNIT}
  --stop                Stop ${UNIT}
  --reload              Hot-reload ${UNIT} via wg syncconf (zero-downtime)
  --restart             Restart ${UNIT}

Options:
  --file PATH           Source .conf file for --import
  --dir PATH            Scan directory for profiles (default: ${DEFAULT_SOURCE_DIR})
  --name NAME           Profile name (lowercase [a-z0-9._-], max 64 chars)
  --activate            Activate profile on ${IFACE} after --import (default)
  --no-activate         Save to ${PROFILES_DIR} without activating on ${IFACE}
  --keep-dns            Keep DNS = entries (default: strip for dnscrypt-proxy + nftables)
  --delete-source       Remove source .conf from ~/Downloads after verified import (rm)
  --keep-source         Keep source .conf untouched after import
  --dry-run             Validate and show planned actions without writing anything
  --yes, -y             Auto-confirm prompts (never deletes source unless --delete-source)
  -h, --help            Show this help
EOF
}

check_deps() {
    local missing=0 cmd
    for cmd in wg wg-quick systemctl ip run0 gawk grep wc head basename cat install mktemp stat sha256sum find sort tr rm mv cp chmod chown; do
        if [[ ! -x "/usr/bin/${cmd}" ]]; then
            err "Missing required binary: /usr/bin/${cmd}"
            missing=1
        fi
    done
    (( missing == 0 ))
}

set_action() {
    local new_action="$1"
    if [[ -n $ACTION && $ACTION != "$new_action" ]]; then
        err "Conflicting actions: --${ACTION} and --${new_action}"
        exit 2
    fi
    ACTION="$new_action"
}

parse_args() {
    while (($#)); do
        case "$1" in
            --status)        set_action "status"; shift ;;
            --list)          set_action "list"; shift ;;
            --import)        set_action "import"; shift ;;
            --adopt)         set_action "adopt"; shift ;;
            --start)         set_action "start"; shift ;;
            --stop)          set_action "stop"; shift ;;
            --reload)        set_action "reload"; shift ;;
            --restart)       set_action "restart"; shift ;;
            --switch)
                (($# >= 2)) || { err "--switch needs a profile NAME"; exit 2; }
                set_action "switch"; PROFILE_NAME="$2"; shift 2 ;;
            --switch=*)
                set_action "switch"; PROFILE_NAME="${1#*=}"; shift ;;
            --delete)
                (($# >= 2)) || { err "--delete needs a profile NAME"; exit 2; }
                set_action "delete"; PROFILE_NAME="$2"; shift 2 ;;
            --delete=*)
                set_action "delete"; PROFILE_NAME="${1#*=}"; shift ;;
            --file)
                (($# >= 2)) || { err "--file needs a PATH"; exit 2; }
                SRC_FILE="$2"; shift 2 ;;
            --file=*)
                SRC_FILE="${1#*=}"; shift ;;
            --dir)
                (($# >= 2)) || { err "--dir needs a PATH"; exit 2; }
                SOURCE_DIR="$2"; shift 2 ;;
            --dir=*)
                SOURCE_DIR="${1#*=}"; shift ;;
            --name)
                (($# >= 2)) || { err "--name needs a value"; exit 2; }
                PROFILE_NAME="$2"; shift 2 ;;
            --name=*)
                PROFILE_NAME="${1#*=}"; shift ;;
            --activate)      ACTIVATE=1; shift ;;
            --no-activate)   ACTIVATE=0; shift ;;
            --keep-dns)      KEEP_DNS=1; shift ;;
            --delete-source) DELETE_SOURCE="yes"; shift ;;
            --keep-source)   DELETE_SOURCE="no"; shift ;;
            --dry-run)       DRY_RUN=1; shift ;;
            --yes|-y)        ASSUME_YES=1; shift ;;
            -h|--help)       usage; exit 0 ;;
            *)
                err "Unknown option: $1"
                usage >&2
                exit 2 ;;
        esac
    done
}

# ---------- System state inspection (non-root) ----------
ipv6_available() {
    local all_val def_val
    [[ -d /proc/sys/net/ipv6/conf ]] || return 1
    all_val=$(</proc/sys/net/ipv6/conf/all/disable_ipv6) 2>/dev/null || all_val=1
    def_val=$(</proc/sys/net/ipv6/conf/default/disable_ipv6) 2>/dev/null || def_val=1
    [[ $all_val == "0" && $def_val == "0" ]]
}

resolvconf_available() {
    [[ -x /usr/bin/resolvconf ]]
}

dnscrypt_active() {
    /usr/bin/systemctl is-active --quiet dnscrypt-proxy.service 2>/dev/null
}

iface_link_dns() {
    [[ -x /usr/bin/resolvectl ]] || return 0
    local out
    out=$(/usr/bin/resolvectl dns "$IFACE" 2>/dev/null || true)
    out="${out#*:}"
    out="${out#"${out%%[![:space:]]*}"}"
    out="${out%"${out##*[![:space:]]}"}"
    printf '%s' "$out"
}

iface_state() {
    local state
    state=$(/usr/bin/systemctl is-active "$UNIT" 2>/dev/null || true)
    [[ $state == "active" ]] && printf 'running' || printf 'stopped'
}

iface_enabled() {
    local state
    state=$(/usr/bin/systemctl is-enabled "$UNIT" 2>/dev/null || true)
    case "$state" in
        enabled)  printf '[enabled]' ;;
        disabled) printf '[disabled]' ;;
        static)   printf '[static]' ;;
        masked)   printf '[masked]' ;;
        *)        printf '[-]' ;;
    esac
}

iface_addr() {
    local addr
    addr=$(/usr/bin/ip -4 -o addr show dev "$IFACE" 2>/dev/null | /usr/bin/gawk '{print $4; exit}')
    printf '%s' "${addr:--}"
}

# Sanitize any untrusted display string to printable ASCII only.
sanitize_display() {
    printf '%s' "$1" | /usr/bin/tr -cd '\040-\176'
}

validate_profile_name() {
    local name="$1"
    if [[ ! $name =~ $PROFILE_NAME_RE ]]; then
        err "Invalid profile name: '${name}' (use lowercase [a-z0-9._-], starting with a-z0-9, max 64 chars)"
        return 1
    fi
    return 0
}

derive_profile_name() {
    local file="$1" label="$2" raw slug
    if [[ -n $label ]]; then
        raw="$label"
    else
        raw=$(/usr/bin/basename -- "$file")
        raw="${raw%.conf}"
    fi
    slug=$(printf '%s' "$raw" \
        | /usr/bin/tr '[:upper:]' '[:lower:]' \
        | /usr/bin/tr -c 'a-z0-9._-' '-' \
        | /usr/bin/gawk '{
            gsub(/-+/, "-")
            sub(/^[^a-z0-9]+/, "")
            sub(/[._-]+$/, "")
            print substr($0, 1, 64)
        }')
    [[ -n $slug ]] || slug="proton-profile"
    printf '%s' "$slug"
}

# ---------- Strict Allowlist Parser & Canonical Serializer (gawk) ----------
# Shared by both unprivileged import sanitization and root-side --adopt.
readonly SANITIZER_AWK='
function trim(s) {
    sub(/^[ \t]+/, "", s)
    sub(/[ \t]+$/, "", s)
    return s
}
function fail(msg) {
    print "PARSE_ERROR: " msg > "/dev/stderr"
    failed = 1
    exit 1
}
function is_base64_key(s) {
    return (s ~ /^[A-Za-z0-9+\/]{43}=$/)
}
function is_ipv4(ip,    a, n, i) {
    n = split(ip, a, ".")
    if (n != 4) return 0
    for (i = 1; i <= 4; i++) {
        if (a[i] !~ /^([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$/) return 0
    }
    return 1
}
function is_ipv4_cidr(s, req_mask,    a, n, p) {
    n = split(s, a, "/")
    if (n == 1) {
        if (req_mask) return 0
        return is_ipv4(a[1])
    }
    if (n != 2) return 0
    if (!is_ipv4(a[1])) return 0
    if (a[2] !~ /^(0|[1-9][0-9]?)$/) return 0
    p = a[2] + 0
    return (p >= 0 && p <= 32)
}
function is_ipv6(ip,    parts, n, i, dcolon, groups, has_v4_tail, tmp) {
    if (ip == "" || ip !~ /^[0-9a-fA-F:.]+$/) return 0
    if (index(ip, ":") == 0) return 0
    if (index(ip, ":::") > 0) return 0
    # Count "::" occurrences (at most 1)
    dcolon = 0
    tmp = ip
    while (sub(/::/, "|", tmp)) dcolon++
    if (dcolon > 1) return 0
    if (ip ~ /^:[^:]/ || ip ~ /[^:]:$/) return 0
    n = split(ip, parts, ":")
    groups = 0
    has_v4_tail = 0
    for (i = 1; i <= n; i++) {
        if (parts[i] == "") continue
        if (i == n && index(parts[i], ".") > 0) {
            if (!is_ipv4(parts[i])) return 0
            groups += 2
            has_v4_tail = 1
        } else if (parts[i] ~ /^[0-9a-fA-F]{1,4}$/) {
            groups++
        } else {
            return 0
        }
    }
    if (dcolon == 1) return (groups < 8)
    return (groups == 8)
}
function is_ipv6_cidr(s, req_mask,    a, n, p) {
    n = split(s, a, "/")
    if (n == 1) {
        if (req_mask) return 0
        return is_ipv6(a[1])
    }
    if (n != 2) return 0
    if (!is_ipv6(a[1])) return 0
    if (a[2] !~ /^(0|[1-9][0-9]{0,2})$/) return 0
    p = a[2] + 0
    return (p >= 0 && p <= 128)
}
function is_hostname(h) {
    if (length(h) < 1 || length(h) > 253) return 0
    return (h ~ /^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$/)
}
function is_port(p) {
    if (p !~ /^[1-9][0-9]{0,4}$/) return 0
    return (p + 0 >= 1 && p + 0 <= 65535)
}
function push_csv(cur, item) {
    return (cur == "" ? item : cur ", " item)
}
function sanitize_label(s) {
    gsub(/[^A-Za-z0-9#._ -]/, "", s)
    s = trim(s)
    return substr(s, 1, 48)
}
BEGIN {
    section = ""
    iface_count = 0
    peer_count = 0
    privkey = ""
    iface_addrs = ""
    iface_dns = ""
    iface_mtu = ""
    peer_label = ""
    has_full_v4 = 0
    stripped_dns = ""
    stripped_ipv6 = ""
    failed = 0
}
{
    line = $0
    sub(/\r$/, "", line)
    t = trim(line)
    if (t == "") next

    if (substr(t, 1, 1) == ";") {
        fail("Semicolon comments (\";\") are not valid in WireGuard configs (line " NR ")")
    }
    if (substr(t, 1, 1) == "#") {
        c = trim(substr(t, 2))
        if (c ~ /^[Ll]abel:[ \t]*/) {
            sub(/^[Ll]abel:[ \t]*/, "", c)
            if (peer_label == "") peer_label = sanitize_label(c)
        } else if (section == "peer" && peer_label == "" && c != "" \
                   && c !~ /^[Uu]ncomment/ && index(c, "=") == 0) {
            peer_label = sanitize_label(c)
        }
        next
    }

    # Strip inline # comment (wg(8) semantics)
    sub(/#.*$/, "", line)
    t = trim(line)
    if (t == "") next

    if (substr(t, 1, 1) == "[") {
        if (t !~ /^\[[^\[\]]+\]$/) {
            fail("Malformed section header at line " NR)
        }
        sec = tolower(trim(substr(t, 2, length(t) - 2)))
        if (sec == "interface") {
            iface_count++
            if (iface_count > 1) fail("Multiple [Interface] sections are not allowed")
            section = "interface"
            next
        } else if (sec == "peer") {
            peer_count++
            section = "peer"
            next
        } else {
            fail("Disallowed section [" sec "] at line " NR)
        }
    }

    if (section == "") {
        fail("Directive outside any section at line " NR)
    }

    eq = index(t, "=")
    if (eq == 0) {
        fail("Malformed directive (missing \"=\") at line " NR)
    }

    raw_key = trim(substr(t, 1, eq - 1))
    val = trim(substr(t, eq + 1))
    if (raw_key == "" || raw_key ~ /[ \t]/) {
        fail("Invalid directive name at line " NR)
    }
    if (val == "") {
        fail("Empty value for \"" raw_key "\" at line " NR)
    }
    lkey = tolower(raw_key)

    if (section == "interface") {
        if (lkey == "privatekey") {
            if (privkey != "") fail("Duplicate PrivateKey in [Interface]")
            if (!is_base64_key(val)) fail("Invalid PrivateKey format (expected 44-char base64)")
            privkey = val
        } else if (lkey == "address") {
            n = split(val, items, ",")
            for (i = 1; i <= n; i++) {
                item = trim(items[i])
                if (item == "") fail("Empty Address entry at line " NR)
                if (is_ipv4_cidr(item, 0)) {
                    iface_addrs = push_csv(iface_addrs, item)
                } else if (is_ipv6_cidr(item, 0)) {
                    if (allow_ipv6 + 0 == 1) {
                        iface_addrs = push_csv(iface_addrs, item)
                    } else {
                        stripped_ipv6 = push_csv(stripped_ipv6, "Address:" item)
                    }
                } else {
                    fail("Invalid Address entry \"" item "\" at line " NR)
                }
            }
        } else if (lkey == "dns") {
            n = split(val, items, ",")
            for (i = 1; i <= n; i++) {
                item = trim(items[i])
                if (item == "") fail("Empty DNS entry at line " NR)
                if (!is_ipv4(item) && !is_ipv6(item) && !is_hostname(item)) {
                    fail("Invalid DNS entry \"" item "\" at line " NR)
                }
                if (keep_dns + 0 == 0) {
                    stripped_dns = push_csv(stripped_dns, item)
                } else if (is_ipv6(item) && allow_ipv6 + 0 == 0) {
                    stripped_ipv6 = push_csv(stripped_ipv6, "DNS:" item)
                } else {
                    iface_dns = push_csv(iface_dns, item)
                }
            }
        } else if (lkey == "mtu") {
            if (iface_mtu != "") fail("Duplicate MTU in [Interface]")
            if (val !~ /^[0-9]+$/ || val + 0 < 1280 || val + 0 > 1500) {
                fail("Invalid MTU \"" val "\" (expected 1280..1500)")
            }
            iface_mtu = val
        } else if (lkey ~ /^(preup|postup|predown|postdown)$/) {
            fail("Security policy violation: hook directive \"" raw_key "\" is forbidden (root command execution)")
        } else if (lkey == "saveconfig") {
            fail("Security policy violation: SaveConfig is forbidden")
        } else if (lkey ~ /^(table|fwmark|listenport)$/) {
            fail("Disallowed [Interface] directive \"" raw_key "\" (managed by system policy)")
        } else {
            fail("Unknown/disallowed [Interface] directive \"" raw_key "\" at line " NR)
        }
    } else if (section == "peer") {
        p = peer_count
        if (lkey == "publickey") {
            if (peer_pub[p] != "") fail("Duplicate PublicKey in [Peer] #" p)
            if (!is_base64_key(val)) fail("Invalid PublicKey format in [Peer] #" p)
            peer_pub[p] = val
        } else if (lkey == "presharedkey") {
            if (peer_psk[p] != "") fail("Duplicate PresharedKey in [Peer] #" p)
            if (!is_base64_key(val)) fail("Invalid PresharedKey format in [Peer] #" p)
            peer_psk[p] = val
        } else if (lkey == "allowedips") {
            n = split(val, items, ",")
            for (i = 1; i <= n; i++) {
                item = trim(items[i])
                if (item == "") fail("Empty AllowedIPs entry at line " NR)
                if (is_ipv4_cidr(item, 1)) {
                    peer_allowed[p] = push_csv(peer_allowed[p], item)
                    if (item == "0.0.0.0/0") has_full_v4 = 1
                } else if (is_ipv6_cidr(item, 1)) {
                    if (allow_ipv6 + 0 == 1) {
                        peer_allowed[p] = push_csv(peer_allowed[p], item)
                    } else {
                        stripped_ipv6 = push_csv(stripped_ipv6, "AllowedIPs:" item)
                    }
                } else {
                    fail("Invalid AllowedIPs entry \"" item "\" at line " NR)
                }
            }
        } else if (lkey == "endpoint") {
            if (peer_ep[p] != "") fail("Duplicate Endpoint in [Peer] #" p)
            if (val ~ /^\[[^\]]+\]:[0-9]+$/) {
                rbr = index(val, "]")
                host = substr(val, 2, rbr - 2)
                port = substr(val, rbr + 2)
                if (!is_ipv6(host) || !is_port(port)) {
                    fail("Invalid IPv6 Endpoint \"" val "\"")
                }
                if (allow_ipv6 + 0 == 0) {
                    fail("Endpoint is IPv6-only (\"" val "\") while IPv6 is disabled on this system")
                }
                peer_ep[p] = "[" host "]:" port
            } else {
                col = index(val, ":")
                if (col == 0 || index(substr(val, col + 1), ":") > 0) {
                    fail("Invalid Endpoint \"" val "\"")
                }
                host = substr(val, 1, col - 1)
                port = substr(val, col + 1)
                if ((!is_ipv4(host) && !is_hostname(host)) || !is_port(port)) {
                    fail("Invalid Endpoint \"" val "\"")
                }
                peer_ep[p] = host ":" port
            }
        } else if (lkey == "persistentkeepalive") {
            if (peer_ka[p] != "") fail("Duplicate PersistentKeepalive in [Peer] #" p)
            lv = tolower(val)
            if (lv != "off" && (lv !~ /^[0-9]+$/ || lv + 0 > 65535)) {
                fail("Invalid PersistentKeepalive \"" val "\" (expected 0..65535 or off)")
            }
            peer_ka[p] = lv
        } else {
            fail("Unknown/disallowed [Peer] directive \"" raw_key "\" at line " NR)
        }
    }
}
END {
    if (failed) exit 1
    if (iface_count != 1) fail("Missing [Interface] section")
    if (privkey == "") fail("Missing PrivateKey in [Interface]")
    if (iface_addrs == "") {
        if (stripped_ipv6 != "") fail("No IPv4 Address left after stripping IPv6 entries")
        fail("Missing Address in [Interface]")
    }
    if (peer_count < 1) fail("Missing [Peer] section")
    for (p = 1; p <= peer_count; p++) {
        if (peer_pub[p] == "") fail("Missing PublicKey in [Peer] #" p)
        if (peer_allowed[p] == "") {
            if (stripped_ipv6 != "") fail("No IPv4 AllowedIPs left in [Peer] #" p " after stripping IPv6 entries")
            fail("Missing AllowedIPs in [Peer] #" p)
        }
        if (peer_ep[p] == "") fail("Missing Endpoint in [Peer] #" p)
    }

    if (mode == "meta") {
        print "LABEL\t" peer_label
        print "ADDRESS\t" iface_addrs
        print "ENDPOINT\t" peer_ep[1]
        print "ALLOWED_IPS\t" peer_allowed[1]
        print "MTU\t" iface_mtu
        print "DNS\t" iface_dns
        print "HAS_FULL_V4\t" has_full_v4
        print "STRIPPED_DNS\t" stripped_dns
        print "STRIPPED_IPV6\t" stripped_ipv6
        print "PEER_COUNT\t" peer_count
        exit 0
    }

    if (mode == "privkey") {
        print privkey
        exit 0
    }

    # mode == "canonical"
    print "[Interface]"
    print "PrivateKey = " privkey
    print "Address = " iface_addrs
    if (iface_dns != "") print "DNS = " iface_dns
    if (iface_mtu != "") print "MTU = " iface_mtu
    for (p = 1; p <= peer_count; p++) {
        print ""
        print "[Peer]"
        if (p == 1 && peer_label != "") print "# Label: " peer_label
        print "PublicKey = " peer_pub[p]
        if (peer_psk[p] != "") print "PresharedKey = " peer_psk[p]
        print "AllowedIPs = " peer_allowed[p]
        print "Endpoint = " peer_ep[p]
        if (peer_ka[p] != "") print "PersistentKeepalive = " peer_ka[p]
    }
}
'

# Read, validate, and sanitize a local .conf file ONCE into CANONICAL_CONFIG.
parse_and_sanitize() {
    local file="$1" size allow_v6=0 raw_text err_msg privkey meta_out k v
    CANONICAL_CONFIG=""
    P_LABEL="" P_ADDRESS="" P_ENDPOINT="" P_ALLOWED_IPS="" P_MTU="" P_DNS=""
    P_HAS_FULL_V4=0 P_STRIPPED_DNS="" P_STRIPPED_IPV6="" P_PEER_COUNT=0

    if [[ -L $file ]]; then
        err "Refusing symlink as source file: $(sanitize_display "$file")"
        return 1
    fi
    if [[ ! -f $file || ! -r $file || ! -s $file ]]; then
        err "Not a readable non-empty regular file: $(sanitize_display "$file")"
        return 1
    fi
    size=$(/usr/bin/stat -c '%s' -- "$file" 2>/dev/null || printf '0')
    if [[ ! $size =~ ^[0-9]+$ ]] || (( size == 0 || size > MAX_CONFIG_BYTES )); then
        err "File size out of allowed bounds (1..${MAX_CONFIG_BYTES} bytes): $(sanitize_display "$file")"
        return 1
    fi
    # Reject NUL, ESC, and any non-printable control characters before reading.
    if (( $(/usr/bin/tr -d '\011\012\015\040-\176' < "$file" | /usr/bin/wc -c) != 0 )); then
        err "File contains disallowed binary or control characters: $(sanitize_display "$file")"
        return 1
    fi

    # Read ONCE into memory (eliminates source TOCTOU completely).
    raw_text=$(/usr/bin/tr -d '\r' < "$file")
    ipv6_available && allow_v6=1 || allow_v6=0

    if ! meta_out=$(printf '%s\n' "$raw_text" | /usr/bin/gawk -v keep_dns="$KEEP_DNS" -v allow_ipv6="$allow_v6" -v mode="meta" "$SANITIZER_AWK" 2>&1); then
        err_msg="${meta_out#PARSE_ERROR: }"
        err "$(sanitize_display "$err_msg")"
        raw_text=""
        return 1
    fi

    while IFS=$'\t' read -r k v; do
        case "$k" in
            LABEL)         P_LABEL="$v" ;;
            ADDRESS)       P_ADDRESS="$v" ;;
            ENDPOINT)      P_ENDPOINT="$v" ;;
            ALLOWED_IPS)   P_ALLOWED_IPS="$v" ;;
            MTU)           P_MTU="$v" ;;
            DNS)           P_DNS="$v" ;;
            HAS_FULL_V4)   P_HAS_FULL_V4="${v:-0}" ;;
            STRIPPED_DNS)  P_STRIPPED_DNS="$v" ;;
            STRIPPED_IPV6) P_STRIPPED_IPV6="$v" ;;
            PEER_COUNT)    P_PEER_COUNT="${v:-0}" ;;
        esac
    done <<< "$meta_out"

    privkey=$(printf '%s\n' "$raw_text" | /usr/bin/gawk -v keep_dns="$KEEP_DNS" -v allow_ipv6="$allow_v6" -v mode="privkey" "$SANITIZER_AWK")
    if ! printf '%s\n' "$privkey" | /usr/bin/wg pubkey >/dev/null 2>&1; then
        privkey=""
        raw_text=""
        err "Cryptographic PrivateKey validation failed (wg pubkey rejected key)"
        return 1
    fi
    privkey=""
    unset privkey

    if ! CANONICAL_CONFIG=$(printf '%s\n' "$raw_text" | /usr/bin/gawk -v keep_dns="$KEEP_DNS" -v allow_ipv6="$allow_v6" -v mode="canonical" "$SANITIZER_AWK"); then
        CANONICAL_CONFIG=""
        raw_text=""
        err "Failed to build canonical WireGuard config"
        return 1
    fi
    raw_text=""
    return 0
}

# ---------- Source scanning (unprivileged, NUL-delimited) ----------
is_wg_candidate() {
    local file="$1" size
    [[ ! -L $file && -f $file && -r $file && -s $file ]] || return 1
    size=$(/usr/bin/stat -c '%s' -- "$file" 2>/dev/null || printf '0')
    [[ $size =~ ^[0-9]+$ ]] && (( size > 0 && size <= MAX_CONFIG_BYTES )) || return 1
    (( $(/usr/bin/tr -d '\011\012\015\040-\176' < "$file" | /usr/bin/wc -c) == 0 )) || return 1
    /usr/bin/grep -qiE '^[[:space:]]*\[Interface\]' -- "$file" || return 1
    /usr/bin/grep -qiE '^[[:space:]]*\[Peer\]' -- "$file" || return 1
    return 0
}

# Populates global array FOUND_PROFILES using NUL-delimited find.
scan_source_dir() {
    local dir="$1" file
    FOUND_PROFILES=()
    [[ -d $dir ]] || return 0
    while IFS= read -r -d '' file; do
        is_wg_candidate "$file" && FOUND_PROFILES+=("$file")
    done < <(/usr/bin/find "$dir" -maxdepth 1 -type f -name '*.conf' -readable -print0 2>/dev/null | /usr/bin/sort -z)
}

source_summary() {
    local file="$1" bname address endpoint
    bname=$(sanitize_display "$(/usr/bin/basename -- "$file")")
    address=$(/usr/bin/gawk '
        BEGIN { IGNORECASE=1 }
        /^[ \t]*\[Interface\][ \t]*$/ { s=1; next }
        /^[ \t]*\[/                   { s=0; next }
        s && /^[ \t]*Address[ \t]*=/ {
            sub(/#.*$/, "")
            sub(/^[^=]*=[ \t]*/, "")
            sub(/[ \t\r]+$/, "")
            print; exit
        }
    ' < "$file")
    endpoint=$(/usr/bin/gawk '
        BEGIN { IGNORECASE=1 }
        /^[ \t]*\[Peer\][ \t]*$/ { s=1; next }
        /^[ \t]*\[/              { s=0; next }
        s && /^[ \t]*Endpoint[ \t]*=/ {
            sub(/#.*$/, "")
            sub(/^[^=]*=[ \t]*/, "")
            sub(/[ \t\r]+$/, "")
            print; exit
        }
    ' < "$file")
    printf '%s' "$bname"
    [[ -n $address ]]  && printf '  [%s]' "$(sanitize_display "$address")"
    [[ -n $endpoint ]] && printf '  -> %s' "$(sanitize_display "$endpoint")"
}

# ---------- Saved profile index (read-only, non-root) ----------
# Populates parallel arrays from /var/lib/importwgp/index.tsv.
IDX_NAMES=()
IDX_LABELS=()
IDX_ADDRS=()
IDX_ENDPOINTS=()
IDX_ALLOWED=()
IDX_MTUS=()
IDX_HAS_DNS=()
IDX_ACTIVE=()

load_index() {
    IDX_NAMES=() IDX_LABELS=() IDX_ADDRS=() IDX_ENDPOINTS=()
    IDX_ALLOWED=() IDX_MTUS=() IDX_HAS_DNS=() IDX_ACTIVE=()
    [[ -f $INDEX_FILE && -r $INDEX_FILE ]] || return 0
    local name label addr ep allowed mtu has_dns active
    while IFS=$'\t' read -r name label addr ep allowed mtu has_dns active; do
        [[ -n $name ]] || continue
        [[ $name =~ $PROFILE_NAME_RE ]] || continue
        IDX_NAMES+=("$name")
        IDX_LABELS+=("$(sanitize_display "$label")")
        IDX_ADDRS+=("$(sanitize_display "$addr")")
        IDX_ENDPOINTS+=("$(sanitize_display "$ep")")
        IDX_ALLOWED+=("$(sanitize_display "$allowed")")
        IDX_MTUS+=("$(sanitize_display "$mtu")")
        IDX_HAS_DNS+=("${has_dns:-0}")
        IDX_ACTIVE+=("${active:-0}")
    done < "$INDEX_FILE"
}

index_has_profile() {
    local target="$1" n
    load_index
    (( ${#IDX_NAMES[@]} > 0 )) || return 1
    for n in "${IDX_NAMES[@]}"; do
        [[ $n == "$target" ]] && return 0
    done
    return 1
}

index_is_active_profile() {
    local target="$1" i
    load_index
    for ((i = 0; i < ${#IDX_NAMES[@]}; i++)); do
        if [[ ${IDX_NAMES[i]} == "$target" && ${IDX_ACTIVE[i]} == "1" ]]; then
            return 0
        fi
    done
    return 1
}

# ---------- Single Atomic Root Helper (executed via run0 --pipe) ----------
# Receives only safe non-secret arguments; config material (when importing)
# arrives exclusively via anonymous stdin pipe, never via argv or /tmp.
build_root_helper() {
    cat <<'ROOT_EOF'
set -euo pipefail
umask 077
export LC_ALL=C
export PATH="/usr/bin:/usr/sbin"

readonly IFACE="png0"
readonly UNIT="wg-quick@png0.service"
readonly WG_DIR="/etc/wireguard"
readonly PROFILES_DIR="/etc/wireguard/profiles"
readonly ACTIVE_CONF="/etc/wireguard/png0.conf"
readonly STATE_DIR="/var/lib/importwgp"
readonly INDEX_FILE="/var/lib/importwgp/index.tsv"
readonly PROFILE_NAME_RE='^[a-z0-9][a-z0-9._-]{0,63}$'
readonly MAX_BYTES=65536

TMP_FILES=()
cleanup_root() {
    local f
    for f in "${TMP_FILES[@]:-}"; do
        [[ -n $f && -e $f ]] && /usr/bin/rm -f -- "$f" || true
    done
}
trap cleanup_root EXIT INT TERM

r_ok()   { printf '  ✓  %s\n' "$*"; }
r_warn() { printf '  !  %s\n' "$*"; }
r_err()  { printf '  ✗  %s\n' "$*" >&2; }

ensure_dirs() {
    if [[ -L $WG_DIR || -L $PROFILES_DIR || -L $STATE_DIR ]]; then
        r_err "Refusing to operate on symlinked system directory"
        exit 1
    fi
    /usr/bin/install -d -m 700 -o root -g root "$WG_DIR"
    /usr/bin/install -d -m 700 -o root -g root "$PROFILES_DIR"
    /usr/bin/install -d -m 750 -o root -g wheel "$STATE_DIR"
}

validate_name() {
    if [[ ! $1 =~ $PROFILE_NAME_RE ]]; then
        r_err "Invalid profile name: $1"
        exit 1
    fi
}

ipv6_ok() {
    local a d
    [[ -d /proc/sys/net/ipv6/conf ]] || return 1
    a=$(</proc/sys/net/ipv6/conf/all/disable_ipv6) 2>/dev/null || a=1
    d=$(</proc/sys/net/ipv6/conf/default/disable_ipv6) 2>/dev/null || d=1
    [[ $a == "0" && $d == "0" ]]
}

# Compute normalized link/route/DNS signature to decide reload vs restart.
link_signature() {
    local file="$1"
    /usr/bin/gawk '
        BEGIN { IGNORECASE=1 }
        /^[ \t]*[#;]/ || /^[ \t]*$/ { next }
        {
            line=$0; sub(/#.*$/, "", line); sub(/\r$/, "", line)
            sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
            if (line == "") next
            if (line ~ /^\[Interface\]$/) { sec="i"; next }
            if (line ~ /^\[Peer\]$/)      { sec="p"; next }
            if (line ~ /^\[/)             { sec="o"; next }
            eq = index(line, "="); if (!eq) next
            k = tolower(substr(line, 1, eq-1)); gsub(/[ \t]/, "", k)
            v = substr(line, eq+1); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
            if (sec == "i" && (k == "address" || k == "dns" || k == "mtu")) {
                n = split(v, a, ",")
                for (i=1; i<=n; i++) {
                    x=a[i]; gsub(/[ \t]/, "", x)
                    if (x != "") print k "=" tolower(x)
                }
            } else if (sec == "p" && k == "allowedips") {
                n = split(v, a, ",")
                for (i=1; i<=n; i++) {
                    x=a[i]; gsub(/[ \t]/, "", x)
                    if (x != "") print "allowedips=" tolower(x)
                }
            }
        }
    ' < "$file" | /usr/bin/sort -u
}

file_has_dns() {
    /usr/bin/gawk '
        BEGIN { IGNORECASE=1; found=0 }
        /^[ \t]*\[Interface\]/ { s=1; next }
        /^[ \t]*\[/            { s=0; next }
        s && /^[ \t]*DNS[ \t]*=/ {
            line=$0; sub(/#.*$/, "", line); sub(/^[^=]*=/, "", line)
            gsub(/[ \t\r]/, "", line)
            if (line != "") { found=1; exit }
        }
        END { exit(found ? 0 : 1) }
    ' < "$1"
}

file_has_ipv6() {
    /usr/bin/gawk '
        BEGIN { IGNORECASE=1; found=0 }
        /^[ \t]*[#;]/ || /^[ \t]*$/ { next }
        {
            line=$0; sub(/#.*$/, "", line); sub(/\r$/, "", line)
            eq = index(line, "="); if (!eq) next
            k = tolower(substr(line, 1, eq-1)); gsub(/[ \t]/, "", k)
            v = substr(line, eq+1)
            if ((k == "address" || k == "dns" || k == "allowedips") && index(v, ":") > 0) {
                found=1; exit
            }
            if (k == "endpoint" && v ~ /\[.*:.*\]/) {
                found=1; exit
            }
        }
        END { exit(found ? 0 : 1) }
    ' < "$1"
}

preflight_conf() {
    local file="$1"
    if file_has_dns "$file" && [[ ! -x /usr/bin/resolvconf ]]; then
        r_err "Config defines DNS but /usr/bin/resolvconf (systemd-resolvconf) is missing"
        return 1
    fi
    if file_has_ipv6 "$file" && ! ipv6_ok; then
        r_err "Config contains IPv6 entries while IPv6 is disabled in kernel"
        return 1
    fi
    return 0
}

sync_index() {
    ensure_dirs
    local active_hash="" tmp f bname pname fhash meta
    if [[ ! -L $ACTIVE_CONF && -f $ACTIVE_CONF ]]; then
        active_hash=$(/usr/bin/sha256sum -- "$ACTIVE_CONF" | /usr/bin/gawk '{print $1}')
    fi
    tmp=$(/usr/bin/mktemp "${STATE_DIR}/.index.tmp.XXXXXX")
    TMP_FILES+=("$tmp")
    : > "$tmp"
    while IFS= read -r -d '' f; do
        [[ ! -L $f && -f $f ]] || continue
        bname=$(/usr/bin/basename -- "$f")
        pname="${bname%.conf}"
        [[ $pname =~ $PROFILE_NAME_RE ]] || continue
        fhash=$(/usr/bin/sha256sum -- "$f" | /usr/bin/gawk '{print $1}')
        local is_active=0
        [[ -n $active_hash && $fhash == "$active_hash" ]] && is_active=1
        meta=$(/usr/bin/gawk -v pname="$pname" -v is_active="$is_active" '
            function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
            function clean(s) { gsub(/[^A-Za-z0-9#.:\/,_ -]/, "", s); return trim(s) }
            BEGIN { IGNORECASE=1; sec=""; label=""; addr=""; ep=""; allowed=""; mtu="auto"; has_dns=0 }
            {
                line=$0; sub(/\r$/, "", line); t=trim(line)
                if (t == "") next
                if (substr(t, 1, 1) == "#") {
                    c=trim(substr(t, 2))
                    if (c ~ /^label:[ \t]*/) {
                        sub(/^label:[ \t]*/, "", c)
                        if (label == "") label=clean(c)
                    } else if (sec == "p" && label == "" && c !~ /^uncomment/ && index(c, "=") == 0) {
                        label=clean(c)
                    }
                    next
                }
                sub(/#.*$/, "", line); t=trim(line); if (t == "") next
                if (t ~ /^\[Interface\]$/) { sec="i"; next }
                if (t ~ /^\[Peer\]$/)      { sec="p"; next }
                if (t ~ /^\[/)             { sec="o"; next }
                eq=index(t, "="); if (!eq) next
                k=tolower(trim(substr(t, 1, eq-1)))
                v=clean(substr(t, eq+1))
                if (sec == "i") {
                    if (k == "address" && addr == "") addr=v
                    else if (k == "mtu" && v != "") mtu=v
                    else if (k == "dns" && v != "") has_dns=1
                } else if (sec == "p") {
                    if (k == "endpoint" && ep == "") ep=v
                    else if (k == "allowedips" && allowed == "") allowed=v
                }
            }
            END {
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%d\t%d\n", pname, label, addr, ep, allowed, mtu, has_dns, is_active
            }
        ' < "$f")
        printf '%s\n' "$meta" >> "$tmp"
    done < <(/usr/bin/find "$PROFILES_DIR" -maxdepth 1 -type f -name '*.conf' -print0 2>/dev/null | /usr/bin/sort -z)
    /usr/bin/chmod 640 "$tmp"
    /usr/bin/chown root:wheel "$tmp"
    /usr/bin/mv -Tf -- "$tmp" "$INDEX_FILE"
}

verify_active() {
    if ! /usr/bin/systemctl is-active --quiet "$UNIT"; then
        r_err "${UNIT} is not active after operation"
        return 1
    fi
    if ! /usr/bin/wg show "$IFACE" >/dev/null 2>&1; then
        r_warn "wg show has no runtime data for ${IFACE} yet"
    fi
    return 0
}

apply_profile_file() {
    local pname="$1" src="$2"
    if [[ -L $src || ! -f $src ]]; then
        r_err "Saved profile not found or invalid: ${pname}"
        exit 1
    fi
    if [[ -L $ACTIVE_CONF ]]; then
        r_err "Refusing to overwrite symlink: ${ACTIVE_CONF}"
        exit 1
    fi
    preflight_conf "$src" || exit 1

    local was_active=0 op="start" old_sig="" new_sig=""
    if /usr/bin/systemctl is-active --quiet "$UNIT"; then
        was_active=1
        if [[ -f $ACTIVE_CONF ]]; then
            old_sig=$(link_signature "$ACTIVE_CONF")
            new_sig=$(link_signature "$src")
            if [[ $old_sig == "$new_sig" ]]; then
                op="reload"
            else
                op="restart"
            fi
        else
            op="restart"
        fi
    fi

    local backup="" staged=""
    if [[ -f $ACTIVE_CONF ]]; then
        backup=$(/usr/bin/mktemp "${WG_DIR}/.png0.backup.XXXXXX")
        TMP_FILES+=("$backup")
        /usr/bin/install -m 600 -o root -g root -- "$ACTIVE_CONF" "$backup"
    fi
    staged=$(/usr/bin/mktemp "${WG_DIR}/.png0.staged.XXXXXX")
    TMP_FILES+=("$staged")
    /usr/bin/install -m 600 -o root -g root -- "$src" "$staged"

    local mode owner
    mode=$(/usr/bin/stat -c '%a' -- "$staged")
    owner=$(/usr/bin/stat -c '%U:%G' -- "$staged")
    if [[ $mode != "600" || $owner != "root:root" ]]; then
        r_err "Permission verification failed on staged config (${mode} ${owner})"
        exit 1
    fi

    if [[ $op == "reload" ]]; then
        /usr/bin/mv -Tf -- "$staged" "$ACTIVE_CONF"
        if /usr/bin/systemctl reload "$UNIT" && verify_active; then
            r_ok "Activated '${pname}' via systemctl reload (wg syncconf, zero-downtime)"
            sync_index
            return 0
        fi
        r_err "Reload failed for '${pname}' — rolling back ${ACTIVE_CONF}"
        if [[ -n $backup && -f $backup ]]; then
            /usr/bin/mv -Tf -- "$backup" "$ACTIVE_CONF"
            /usr/bin/systemctl reload "$UNIT" 2>/dev/null || true
        fi
        sync_index
        printf '     Details: journalctl -u %s -n 30 --no-pager\n' "$UNIT" >&2
        exit 1
    fi

    # start or restart: if running, stop first against OLD config so wg-quick down
    # cleanly tears down old DNS/routes before swapping ACTIVE_CONF.
    if [[ $op == "restart" ]]; then
        r_warn "Link/DNS/route parameters changed — restarting ${UNIT} (brief clearnet window)"
        /usr/bin/systemctl stop "$UNIT" || true
    fi

    /usr/bin/mv -Tf -- "$staged" "$ACTIVE_CONF"
    if /usr/bin/systemctl start "$UNIT" && verify_active; then
        r_ok "Activated '${pname}' via systemctl ${op} (${ACTIVE_CONF} 600 root:root)"
        sync_index
        return 0
    fi

    r_err "Failed to ${op} ${UNIT} for '${pname}' — rolling back"
    if [[ -n $backup && -f $backup ]]; then
        /usr/bin/mv -Tf -- "$backup" "$ACTIVE_CONF"
        if (( was_active == 1 )); then
            /usr/bin/systemctl start "$UNIT" 2>/dev/null || true
        fi
    fi
    sync_index
    printf '     Details: journalctl -u %s -n 30 --no-pager\n' "$UNIT" >&2
    exit 1
}

action="${1:-}"
shift || true

case "$action" in
    import)
        pname="${1:?missing name}"
        activate="${2:-1}"
        validate_name "$pname"
        ensure_dirs
        dest="${PROFILES_DIR}/${pname}.conf"
        if [[ -L $dest ]]; then
            r_err "Refusing to overwrite symlink: ${dest}"
            exit 1
        fi
        tmp=$(/usr/bin/mktemp "${PROFILES_DIR}/.${pname}.tmp.XXXXXX")
        TMP_FILES+=("$tmp")
        /usr/bin/head -c $((MAX_BYTES + 1)) > "$tmp"
        sz=$(/usr/bin/stat -c '%s' -- "$tmp")
        if (( sz == 0 || sz > MAX_BYTES )); then
            r_err "Invalid stdin payload size (${sz} bytes)"
            exit 1
        fi
        /usr/bin/chmod 600 "$tmp"
        /usr/bin/chown root:root "$tmp"
        /usr/bin/mv -Tf -- "$tmp" "$dest"
        mode=$(/usr/bin/stat -c '%a' -- "$dest")
        owner=$(/usr/bin/stat -c '%U:%G' -- "$dest")
        if [[ $mode != "600" || $owner != "root:root" ]]; then
            r_err "Permission check failed on ${dest} (${mode} ${owner})"
            exit 1
        fi
        r_ok "Saved profile '${pname}' to ${dest} (600 root:root)"
        if [[ $activate == "1" ]]; then
            apply_profile_file "$pname" "$dest"
        else
            sync_index
        fi
        ;;
    switch)
        pname="${1:?missing name}"
        validate_name "$pname"
        ensure_dirs
        apply_profile_file "$pname" "${PROFILES_DIR}/${pname}.conf"
        ;;
    delete)
        pname="${1:?missing name}"
        validate_name "$pname"
        ensure_dirs
        target="${PROFILES_DIR}/${pname}.conf"
        if [[ -L $target || ! -f $target ]]; then
            r_err "Profile not found: ${pname}"
            exit 1
        fi
        if [[ ! -L $ACTIVE_CONF && -f $ACTIVE_CONF ]]; then
            h1=$(/usr/bin/sha256sum -- "$ACTIVE_CONF" | /usr/bin/gawk '{print $1}')
            h2=$(/usr/bin/sha256sum -- "$target" | /usr/bin/gawk '{print $1}')
            if [[ $h1 == "$h2" ]]; then
                r_err "Refusing to delete active profile '${pname}'. Switch to another profile first."
                exit 1
            fi
        fi
        /usr/bin/rm -f -- "$target"
        sync_index
        r_ok "Deleted profile '${pname}'"
        ;;
    service)
        svc_op="${1:?missing service op}"
        ensure_dirs
        case "$svc_op" in
            start|restart|reload)
                if [[ -L $ACTIVE_CONF || ! -f $ACTIVE_CONF ]]; then
                    r_err "Active config missing: ${ACTIVE_CONF}"
                    exit 1
                fi
                preflight_conf "$ACTIVE_CONF" || exit 1
                if [[ $svc_op == "reload" ]] && ! /usr/bin/systemctl is-active --quiet "$UNIT"; then
                    r_err "${UNIT} is not running — use start instead of reload"
                    exit 1
                fi
                if ! /usr/bin/systemctl "$svc_op" "$UNIT"; then
                    r_err "systemctl ${svc_op} ${UNIT} failed"
                    printf '     Details: journalctl -u %s -n 30 --no-pager\n' "$UNIT" >&2
                    exit 1
                fi
                verify_active || exit 1
                r_ok "Executed systemctl ${svc_op} ${UNIT}"
                ;;
            stop)
                if ! /usr/bin/systemctl stop "$UNIT"; then
                    r_err "systemctl stop ${UNIT} failed"
                    exit 1
                fi
                r_ok "Stopped ${UNIT}"
                ;;
            *)
                r_err "Invalid service operation: ${svc_op}"
                exit 1 ;;
        esac
        sync_index
        ;;
    adopt)
        req_name="${1:-}"
        keep_dns="${2:-0}"
        ensure_dirs
        if [[ -L $ACTIVE_CONF || ! -f $ACTIVE_CONF || ! -s $ACTIVE_CONF ]]; then
            r_err "No regular non-empty ${ACTIVE_CONF} to adopt"
            exit 1
        fi
        sz=$(/usr/bin/stat -c '%s' -- "$ACTIVE_CONF")
        if (( sz == 0 || sz > MAX_BYTES )); then
            r_err "Unexpected size on ${ACTIVE_CONF} (${sz} bytes)"
            exit 1
        fi
        if (( $(/usr/bin/tr -d '\011\012\015\040-\176' < "$ACTIVE_CONF" | /usr/bin/wc -c) != 0 )); then
            r_err "${ACTIVE_CONF} contains disallowed binary/control characters"
            exit 1
        fi
        allow_v6=0
        ipv6_ok && allow_v6=1 || allow_v6=0

        # Read sanitizer awk program from stdin (no secrets in stdin/argv).
        awk_prog=$(/usr/bin/cat)
        raw_text=$(/usr/bin/tr -d '\r' < "$ACTIVE_CONF")
        if ! meta_out=$(printf '%s\n' "$raw_text" | /usr/bin/gawk -v keep_dns="$keep_dns" -v allow_ipv6="$allow_v6" -v mode="meta" "$awk_prog" 2>&1); then
            r_err "Could not sanitize ${ACTIVE_CONF}: ${meta_out#PARSE_ERROR: }"
            exit 1
        fi
        label="" stripped_dns="" stripped_v6=""
        while IFS=$'\t' read -r k v; do
            case "$k" in
                LABEL)         label="$v" ;;
                STRIPPED_DNS)  stripped_dns="$v" ;;
                STRIPPED_IPV6) stripped_v6="$v" ;;
            esac
        done <<< "$meta_out"

        if [[ -z $req_name ]]; then
            src_lbl="${label:-png0-adopted}"
            req_name=$(printf '%s' "$src_lbl" \
                | /usr/bin/tr '[:upper:]' '[:lower:]' \
                | /usr/bin/tr -c 'a-z0-9._-' '-' \
                | /usr/bin/gawk '{ gsub(/-+/, "-"); sub(/^[^a-z0-9]+/, ""); sub(/[._-]+$/, ""); print substr($0, 1, 64) }')
            [[ -n $req_name ]] || req_name="png0-adopted"
        fi
        validate_name "$req_name"

        privkey=$(printf '%s\n' "$raw_text" | /usr/bin/gawk -v keep_dns="$keep_dns" -v allow_ipv6="$allow_v6" -v mode="privkey" "$awk_prog")
        if ! printf '%s\n' "$privkey" | /usr/bin/wg pubkey >/dev/null 2>&1; then
            privkey=""
            r_err "PrivateKey in ${ACTIVE_CONF} failed wg pubkey validation"
            exit 1
        fi
        privkey=""
        unset privkey

        tmp=$(/usr/bin/mktemp "${PROFILES_DIR}/.${req_name}.tmp.XXXXXX")
        TMP_FILES+=("$tmp")
        printf '%s\n' "$raw_text" | /usr/bin/gawk -v keep_dns="$keep_dns" -v allow_ipv6="$allow_v6" -v mode="canonical" "$awk_prog" > "$tmp"
        raw_text=""
        /usr/bin/chmod 600 "$tmp"
        /usr/bin/chown root:root "$tmp"
        dest="${PROFILES_DIR}/${req_name}.conf"
        if [[ -L $dest ]]; then
            r_err "Refusing to overwrite symlink: ${dest}"
            exit 1
        fi
        /usr/bin/mv -Tf -- "$tmp" "$dest"
        [[ -n $stripped_dns ]] && r_ok "Stripped DNS (${stripped_dns}) for dnscrypt-proxy + nftables alignment"
        [[ -n $stripped_v6 ]]  && r_ok "Stripped IPv6 entries (${stripped_v6})"
        r_ok "Adopted '${req_name}' into ${dest} (600 root:root)"
        apply_profile_file "$req_name" "$dest"
        ;;
    sync-index)
        sync_index
        r_ok "Synced ${INDEX_FILE}"
        ;;
    *)
        r_err "Unknown root action: ${action}"
        exit 1 ;;
esac
ROOT_EOF
}

run_root() {
    local action="$1"
    shift
    local helper
    helper=$(build_root_helper)
    printf '  %sPolkit authentication (run0) may be required...%s\n' "$C_DIM" "$C_NC"
    /usr/bin/run0 --pipe --background="" --description="importwgp: ${action}" \
        -- /usr/bin/bash -c "$helper" _ "$action" "$@"
}

# ---------- Prompts ----------
confirm() {
    local prompt="$1" default="$2" answer
    if (( ASSUME_YES == 1 )); then
        return 0
    fi
    if (( default == 1 )); then
        printf '  %s [Y/n] ' "$prompt"
    else
        printf '  %s [y/N] ' "$prompt"
    fi
    IFS= read -r answer || true
    case "${answer,,}" in
        y|yes) return 0 ;;
        n|no)  return 1 ;;
        '')    (( default == 1 )) && return 0 || return 1 ;;
        *)     (( default == 1 )) && return 0 || return 1 ;;
    esac
}

# ---------- Core Actions ----------
print_status() {
    local state enabled addr link_dns active_idx=-1 i
    state=$(iface_state)
    enabled=$(iface_enabled)
    addr=$(iface_addr)
    link_dns=$(iface_link_dns)
    load_index

    for ((i = 0; i < ${#IDX_NAMES[@]}; i++)); do
        if [[ ${IDX_ACTIVE[i]} == "1" ]]; then
            active_idx=$i
            break
        fi
    done

    printf '  %sstatus:%s\n' "$C_CYAN" "$C_NC"
    printf '    %-9s %-6s %-9s %-11s %s\n' "iface" "$IFACE" "$state" "$enabled" "$addr"
    if (( active_idx >= 0 )); then
        local lbl="${IDX_LABELS[active_idx]}"
        if [[ -n $lbl ]]; then
            printf '    %-9s %s  (%s -> %s)\n' "profile" "${IDX_NAMES[active_idx]}" "$lbl" "${IDX_ENDPOINTS[active_idx]}"
        else
            printf '    %-9s %s  (%s)\n' "profile" "${IDX_NAMES[active_idx]}" "${IDX_ENDPOINTS[active_idx]}"
        fi
    else
        printf '    %-9s %sunmanaged%s (run %s --adopt to register %s)\n' \
            "profile" "$C_YELLOW" "$C_NC" "$PROG" "$ACTIVE_CONF"
    fi

    if [[ -n $link_dns ]]; then
        if dnscrypt_active; then
            printf '    %-9s %s! %s has link DNS (%s) — conflicts with dnscrypt-proxy/nftables%s\n' \
                "dns" "$C_YELLOW" "$IFACE" "$link_dns" "$C_NC"
        else
            printf '    %-9s %s (%s)\n' "dns" "$link_dns" "$IFACE"
        fi
    elif dnscrypt_active; then
        printf '    %-9s dnscrypt-proxy (clean)\n' "dns"
    else
        printf '    %-9s system default\n' "dns"
    fi

    printf '    %-9s %d saved in %s\n' "library" "${#IDX_NAMES[@]}" "$PROFILES_DIR"
}

list_action() {
    local i file
    load_index
    printf '%sSaved profiles (%s):%s\n' "$C_CYAN" "$PROFILES_DIR" "$C_NC"
    if ((${#IDX_NAMES[@]} == 0)); then
        printf '  (none — use --import or --adopt)\n'
    else
        for ((i = 0; i < ${#IDX_NAMES[@]}; i++)); do
            local mark=" "
            [[ ${IDX_ACTIVE[i]} == "1" ]] && mark="*"
            printf '  %s %-22s  %-14s  -> %-22s  [%s]\n' \
                "$mark" "${IDX_NAMES[i]}" "${IDX_LABELS[i]:--}" "${IDX_ENDPOINTS[i]}" "${IDX_ADDRS[i]}"
        done
    fi

    scan_source_dir "$SOURCE_DIR"
    printf '\n%sDetected configs in %s:%s\n' "$C_CYAN" "$SOURCE_DIR" "$C_NC"
    if ((${#FOUND_PROFILES[@]} == 0)); then
        printf '  (none)\n'
    else
        for file in "${FOUND_PROFILES[@]}"; do
            printf '  %s\n' "$(source_summary "$file")"
        done
    fi
}

cleanup_source_file() {
    local file="$1"
    [[ -f $file && ! -L $file ]] || return 0
    if [[ $DELETE_SOURCE == "no" ]]; then
        return 0
    fi
    if [[ $DELETE_SOURCE == "yes" ]]; then
        /usr/bin/rm -f -- "$file"
        ok "Removed source file: $(sanitize_display "$file")"
        return 0
    fi
    # In non-interactive --yes mode, NEVER delete source unless --delete-source was explicit.
    if (( ASSUME_YES == 1 )); then
        warn "Source file remains in $(sanitize_display "$file") (pass --delete-source to remove)"
        return 0
    fi
    printf '\n'
    warn "Source holds a plaintext PrivateKey (exposed to user processes & Snapper @home)."
    if confirm "Remove source file $(sanitize_display "$(/usr/bin/basename -- "$file")")?" 1; then
        /usr/bin/rm -f -- "$file"
        ok "Removed source file: $(sanitize_display "$file")"
    else
        warn "Kept source file: $(sanitize_display "$file")"
    fi
}

run_import() {
    local interactive="${1:-0}" default_name chosen_name
    if [[ -z $SRC_FILE ]]; then
        err "No source file selected"
        return 1
    fi

    parse_and_sanitize "$SRC_FILE" || return 1

    # Preflight when --keep-dns is explicitly requested.
    if (( KEEP_DNS == 1 )) && [[ -n $P_DNS ]]; then
        if ! resolvconf_available; then
            err "Cannot keep DNS (${P_DNS}): /usr/bin/resolvconf (systemd-resolvconf) is missing"
            return 1
        fi
    fi

    default_name=$(derive_profile_name "$SRC_FILE" "$P_LABEL")
    if [[ -n $PROFILE_NAME ]]; then
        chosen_name="$PROFILE_NAME"
    elif (( interactive == 1 )); then
        printf '\n  Profile name [%s]: ' "$default_name"
        IFS= read -r chosen_name || true
        [[ -n $chosen_name ]] || chosen_name="$default_name"
    else
        chosen_name="$default_name"
    fi
    validate_profile_name "$chosen_name" || return 1

    local exists=0
    index_has_profile "$chosen_name" && exists=1 || exists=0

    printf '\n  %sImport plan%s\n' "$C_CYAN" "$C_NC"
    printf '    source      : %s\n' "$(sanitize_display "$SRC_FILE")"
    printf '    profile     : %s%s\n' "$chosen_name" "$( (( exists == 1 )) && printf ' (OVERWRITE existing)' || true )"
    [[ -n $P_LABEL ]] && printf '    label       : %s\n' "$P_LABEL"
    printf '    address     : %s\n' "$P_ADDRESS"
    printf '    endpoint    : %s\n' "$P_ENDPOINT"
    printf '    allowed-ips : %s\n' "$P_ALLOWED_IPS"
    if [[ -n $P_DNS ]]; then
        printf '    dns         : %s (kept via --keep-dns)\n' "$P_DNS"
    elif [[ -n $P_STRIPPED_DNS ]]; then
        printf '    dns         : stripped (%s -> dnscrypt-proxy mode)\n' "$P_STRIPPED_DNS"
    else
        printf '    dns         : none\n'
    fi
    if [[ -n $P_STRIPPED_IPV6 ]]; then
        printf '    ipv6        : stripped (%s)\n' "$P_STRIPPED_IPV6"
    fi
    printf '    target      : %s/%s.conf (600 root:root)\n' "$PROFILES_DIR" "$chosen_name"
    printf '    activate    : %s\n' "$( (( ACTIVATE == 1 )) && printf "yes (%s via smart reload/start)" "$IFACE" || printf "no (library only)" )"

    if (( P_HAS_FULL_V4 == 0 )); then
        warn "AllowedIPs does NOT contain 0.0.0.0/0 (split-tunnel — non-matching traffic bypasses VPN!)"
    fi
    if [[ -n $P_DNS ]] && dnscrypt_active; then
        warn "Keeping DNS (${P_DNS}) while dnscrypt-proxy is active may conflict with nftables port 53 block"
    fi

    if (( DRY_RUN == 1 )); then
        printf '  [dry-run] Validated & sanitized OK (no changes written)\n'
        return 0
    fi

    if ! confirm "Proceed with importing '${chosen_name}'?" 1; then
        warn "Import cancelled"
        return 2
    fi

    if ! printf '%s\n' "$CANONICAL_CONFIG" | run_root import "$chosen_name" "$ACTIVATE"; then
        CANONICAL_CONFIG=""
        return 1
    fi
    CANONICAL_CONFIG=""

    cleanup_source_file "$SRC_FILE"
    return 0
}

run_switch() {
    local target="$1"
    validate_profile_name "$target" || return 1
    if ! index_has_profile "$target"; then
        err "Saved profile not found in index: ${target}"
        return 1
    fi
    if (( DRY_RUN == 1 )); then
        printf '  [dry-run] Would switch %s to saved profile %s (smart reload/restart)\n' "$IFACE" "$target"
        return 0
    fi
    if ! confirm "Switch ${IFACE} to profile '${target}'?" 1; then
        warn "Switch cancelled"
        return 2
    fi
    run_root switch "$target" </dev/null
}

run_delete() {
    local target="$1"
    validate_profile_name "$target" || return 1
    if ! index_has_profile "$target"; then
        err "Saved profile not found in index: ${target}"
        return 1
    fi
    if index_is_active_profile "$target"; then
        err "Profile '${target}' is currently active on ${IFACE}. Switch to another profile first."
        return 1
    fi
    if (( DRY_RUN == 1 )); then
        printf '  [dry-run] Would delete %s/%s.conf\n' "$PROFILES_DIR" "$target"
        return 0
    fi
    if ! confirm "Permanently delete saved profile '${target}'?" 0; then
        warn "Delete cancelled"
        return 2
    fi
    run_root delete "$target" </dev/null
}

run_service() {
    local svc_op="$1"
    if (( DRY_RUN == 1 )); then
        printf '  [dry-run] Would run systemctl %s %s\n' "$svc_op" "$UNIT"
        return 0
    fi
    run_root service "$svc_op" </dev/null
}

run_adopt() {
    if [[ -n $PROFILE_NAME ]]; then
        validate_profile_name "$PROFILE_NAME" || return 1
    fi
    printf '\n  %sAdopt plan%s\n' "$C_CYAN" "$C_NC"
    printf '    source  : %s\n' "$ACTIVE_CONF"
    printf '    profile : %s\n' "${PROFILE_NAME:-(auto from # Peer label)}"
    printf '    dns     : %s\n' "$( (( KEEP_DNS == 1 )) && printf 'keep' || printf 'strip (dnscrypt-proxy alignment)' )"
    printf '    ipv6    : %s\n' "$( ipv6_available && printf 'keep (IPv6 enabled)' || printf 'auto-strip (IPv6 disabled)' )"

    if (( DRY_RUN == 1 )); then
        printf '  [dry-run] Would adopt & sanitize %s into %s\n' "$ACTIVE_CONF" "$PROFILES_DIR"
        return 0
    fi
    if ! confirm "Adopt and sanitize ${ACTIVE_CONF} now?" 1; then
        warn "Adopt cancelled"
        return 2
    fi
    printf '%s\n' "$SANITIZER_AWK" | run_root adopt "$PROFILE_NAME" "$KEEP_DNS"
}

# ---------- TUI ----------
pause_menu() {
    [[ -t 0 ]] || return 0
    printf '\n  %s[Enter] to continue...%s' "$C_DIM" "$C_NC"
    IFS= read -r _ || true
}

draw_menu() {
    printf '\033[2J\033[H'
    printf '\n  %s> %s%s\n\n' "$C_BOLD" "$PROG" "$C_NC"
    print_status
    printf '\n  [1] import profile   %s(from %s)%s\n' "$C_DIM" "$SOURCE_DIR" "$C_NC"
    printf '  [2] switch profile   %s(hot-reload %s)%s\n' "$C_DIM" "$IFACE" "$C_NC"
    printf '  [3] service control  %s(start / stop / reload / restart)%s\n' "$C_DIM" "$C_NC"
    printf '  [4] delete profile   %s(from library)%s\n' "$C_DIM" "$C_NC"
    printf '  [q] quit\n\n'
}

import_tui() {
    local i=1 choice file rc
    SRC_FILE=""
    PROFILE_NAME=""
    ACTIVATE=1

    scan_source_dir "$SOURCE_DIR"
    if ((${#FOUND_PROFILES[@]} == 0)); then
        err "No WireGuard .conf files found in ${SOURCE_DIR}"
        pause_menu
        return 0
    fi

    printf '\n  %sProfiles in %s:%s\n' "$C_CYAN" "$SOURCE_DIR" "$C_NC"
    for file in "${FOUND_PROFILES[@]}"; do
        printf '    [%d] %s\n' "$i" "$(source_summary "$file")"
        i=$((i + 1))
    done
    printf '    [q] back\n\n'

    IFS= read -r -p '  select: ' choice || true
    case "$choice" in
        q|Q) return 0 ;;
        ''|*[!0-9]*) warn "Invalid selection"; pause_menu; return 0 ;;
    esac
    choice=$((10#$choice))
    if (( choice < 1 || choice > ${#FOUND_PROFILES[@]} )); then
        warn "Selection out of range"
        pause_menu
        return 0
    fi
    SRC_FILE="${FOUND_PROFILES[choice-1]}"

    if confirm "Activate on ${IFACE} immediately after saving?" 1; then
        ACTIVATE=1
    else
        ACTIVATE=0
    fi

    run_import 1 || rc=$?
    pause_menu
    return 0
}

switch_tui() {
    local i choice
    load_index
    if ((${#IDX_NAMES[@]} == 0)); then
        err "No saved profiles in ${PROFILES_DIR}. Import a profile or run '${PROG} --adopt' first."
        pause_menu
        return 0
    fi

    printf '\n  %sSaved profiles:%s\n' "$C_CYAN" "$C_NC"
    for ((i = 0; i < ${#IDX_NAMES[@]}; i++)); do
        local mark=" "
        [[ ${IDX_ACTIVE[i]} == "1" ]] && mark="*"
        printf '    [%d] %s %-20s %-14s -> %s\n' \
            "$((i + 1))" "$mark" "${IDX_NAMES[i]}" "${IDX_LABELS[i]:--}" "${IDX_ENDPOINTS[i]}"
    done
    printf '    [q] back\n\n'

    IFS= read -r -p '  select: ' choice || true
    case "$choice" in
        q|Q) return 0 ;;
        ''|*[!0-9]*) warn "Invalid selection"; pause_menu; return 0 ;;
    esac
    choice=$((10#$choice))
    if (( choice < 1 || choice > ${#IDX_NAMES[@]} )); then
        warn "Selection out of range"
        pause_menu
        return 0
    fi

    run_switch "${IDX_NAMES[choice-1]}" || true
    pause_menu
    return 0
}

service_tui() {
    local choice
    printf '\n  %sService control (%s):%s\n' "$C_CYAN" "$UNIT" "$C_NC"
    printf '    [1] start\n'
    printf '    [2] stop\n'
    printf '    [3] reload   %s(wg syncconf — zero-downtime)%s\n' "$C_DIM" "$C_NC"
    printf '    [4] restart  %s(full down/up)%s\n' "$C_DIM" "$C_NC"
    printf '    [q] back\n\n'

    IFS= read -r -p '  select: ' choice || true
    case "$choice" in
        1) run_service start || true ;;
        2) confirm "Stop ${UNIT}? (Traffic will route via clearnet)" 0 && run_service stop || true ;;
        3) run_service reload || true ;;
        4) confirm "Restart ${UNIT}? (Brief clearnet window during restart)" 0 && run_service restart || true ;;
        q|Q) return 0 ;;
        *) warn "Invalid selection" ;;
    esac
    pause_menu
    return 0
}

delete_tui() {
    local i choice
    load_index
    if ((${#IDX_NAMES[@]} == 0)); then
        err "No saved profiles in ${PROFILES_DIR}"
        pause_menu
        return 0
    fi

    printf '\n  %sDelete saved profile:%s\n' "$C_CYAN" "$C_NC"
    for ((i = 0; i < ${#IDX_NAMES[@]}; i++)); do
        local tag=""
        [[ ${IDX_ACTIVE[i]} == "1" ]] && tag=" [active - locked]"
        printf '    [%d] %-20s %-14s%s\n' "$((i + 1))" "${IDX_NAMES[i]}" "${IDX_LABELS[i]:--}" "$tag"
    done
    printf '    [q] back\n\n'

    IFS= read -r -p '  select: ' choice || true
    case "$choice" in
        q|Q) return 0 ;;
        ''|*[!0-9]*) warn "Invalid selection"; pause_menu; return 0 ;;
    esac
    choice=$((10#$choice))
    if (( choice < 1 || choice > ${#IDX_NAMES[@]} )); then
        warn "Selection out of range"
        pause_menu
        return 0
    fi

    run_delete "${IDX_NAMES[choice-1]}" || true
    pause_menu
    return 0
}

menu_loop() {
    local key
    if [[ ! -t 0 ]]; then
        err "Interactive menu needs a TTY. Use --help for one-shot mode."
        return 1
    fi
    ORIG_STTY=$(/usr/bin/stty -g 2>/dev/null || true)
    while true; do
        draw_menu
        if ! IFS= read -r -n 1 -p '  select: ' key; then
            printf '\n'
            return 0
        fi
        printf '\n'
        case "$key" in
            1) import_tui ;;
            2) switch_tui ;;
            3) service_tui ;;
            4) delete_tui ;;
            q|Q) printf '\n'; return 0 ;;
            *) warn "Press 1, 2, 3, 4 or q."; pause_menu ;;
        esac
    done
}

# ---------- One-shot resolution ----------
resolve_source_one_shot() {
    if [[ -n $SRC_FILE ]]; then
        return 0
    fi
    scan_source_dir "$SOURCE_DIR"
    case ${#FOUND_PROFILES[@]} in
        0)
            err "No WireGuard configs found in ${SOURCE_DIR}. Use --file PATH."
            return 1 ;;
        1)
            SRC_FILE="${FOUND_PROFILES[0]}" ;;
        *)
            err "Multiple profiles found in ${SOURCE_DIR}. Use --file PATH:"
            local f
            for f in "${FOUND_PROFILES[@]}"; do
                err "  $(sanitize_display "$(/usr/bin/basename -- "$f")")"
            done
            return 1 ;;
    esac
    return 0
}

main() {
    local had_args=$# rc=0
    parse_args "$@"
    check_deps || exit 1

    # Backward-compatible shorthand: passing --file PATH implies --import.
    if [[ -z $ACTION && -n $SRC_FILE ]]; then
        ACTION="import"
    fi

    if (( had_args == 0 )); then
        menu_loop
        exit $?
    fi

    case "$ACTION" in
        status)  print_status ;;
        list)    list_action ;;
        import)
            resolve_source_one_shot || exit 1
            run_import 0 || rc=$?
            (( rc == 2 )) && exit 0
            exit "$rc" ;;
        switch)
            run_switch "$PROFILE_NAME" || rc=$?
            (( rc == 2 )) && exit 0
            exit "$rc" ;;
        delete)
            run_delete "$PROFILE_NAME" || rc=$?
            (( rc == 2 )) && exit 0
            exit "$rc" ;;
        adopt)
            run_adopt || rc=$?
            (( rc == 2 )) && exit 0
            exit "$rc" ;;
        start|stop|reload|restart)
            run_service "$ACTION" ;;
        '')
            # Operational modifiers without explicit action (e.g. --dir PATH): open TUI if TTY.
            if [[ -t 0 && $DRY_RUN -eq 0 ]]; then
                menu_loop
            else
                err "No action specified. Use --import, --list, --status, or --help."
                exit 2
            fi ;;
    esac
}

main "$@"
